    "notifications.foreground": "#F2E8FF",
    "notifications.border": "#8040A0",
    "quickInput.background": "#27143D",
    "quickInput.foreground": "#F5EBFF",
    "pickerGroup.foreground": "#FFAE55",
    "gitDecoration.addedResourceForeground": "#70E7A7",
    "gitDecoration.modifiedResourceForeground": "#FFBA62",
    "gitDecoration.deletedResourceForeground": "#FF6F97",
    "gitDecoration.untrackedResourceForeground": "#2CE3D5",
    "list.focusAndSelectionOutline": "#53F4EE",
    "terminal.selectionBackground": "#4C315C99"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A779D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#FF9E39",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#B9F27C"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#FF667A"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#5CB8FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "storage.type"
      ],
      "settings": {
        "foreground": "#FF4FD8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#F5F4FF"
      }
    },
    {
      "scope": [
        "text.html.basic"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#FF7D96"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#CFA5FF"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#BBA8D3"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#FFAD55",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F9E9FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D3B8F7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#2CE8DC"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#FFAD55",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.list",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#C88BFF"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#B73465"
      }
    },
    {
      "scope": [
        "storage.type.annotation.java",
        "punctuation.definition.annotation.java"
      ],
      "settings": {
        "foreground": "#39E6D4",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#FF4FD8",
    "class": "#FF4FD8",
    "interface": "#FF4FD8",
    "enum": "#FF4FD8",
    "typeParameter": "#FF4FD8",
    "function": "#5CB8FF",
    "method": "#5CB8FF",
    "parameter": "#F5F4FF",
    "property": "#CFA5FF",
    "variable": "#F5F4FF",
    "string": "#B9F27C",
    "number": "#FF667A",
    "keyword": "#FF9E39",
    "comment": {
      "foreground": "#8A779D",
      "italic": true
    }
  }
}
